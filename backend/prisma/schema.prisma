datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ========================================================
// ENUMS
// ========================================================

enum AdminRole {
  SUPERADMIN
  ADMIN
  MODERATOR
}

enum EventStatus {
  UPCOMING
  ONGOING
  PAST
}

enum RegistrationStatus {
  PENDING
  CONFIRMED
  ATTENDED
  CANCELLED
}

enum ProjectStatus {
  ACTIVE
  COMPLETED
  ON_HOLD
}

enum AnnouncementCategory {
  RECRUITMENT
  EVENT
  ALERT
  GENERAL
}

enum GalleryCategory {
  EVENTS
  WORKSHOPS
  MEETINGS
  HACKATHONS
  PROJECTS
  COMMUNITY
}

enum ApplicationStatus {
  PENDING
  REVIEWED
  ACCEPTED
  REJECTED
}

// ========================================================
// AUTHENTICATION & ACCESS CONTROL
// ========================================================

model AdminUser {
  id           String    @id @default(uuid()) @db.Uuid
  username     String    @unique @db.VarChar(50)
  email        String    @unique @db.VarChar(255)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  name         String    @db.VarChar(100)
  role         AdminRole @default(ADMIN)
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([email])
  @@index([isActive])
  @@map("admin_users")
}

// ========================================================
// DIVISIONS & MEMBERS
// ========================================================

model Division {
  id               String   @id @default(uuid()) @db.Uuid
  name             String   @unique @db.VarChar(100)
  slug             String   @unique @db.VarChar(100)
  description      String   @db.Text
  leadId           String?  @unique @map("lead_id") @db.Uuid
  responsibilities String[] @default([])
  skills           String[] @default([])
  tools            String[] @default([])
  ongoingWork      String   @default("") @map("ongoing_work") @db.Text
  iconName         String   @default("Code") @map("icon_name") @db.VarChar(50)
  displayOrder     Int      @default(0) @map("display_order")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  // Relationships
  lead         Member?       @relation("DivisionLead", fields: [leadId], references: [id], onDelete: SetNull)
  members      Member[]      @relation("DivisionMembers")
  applications Application[]

  @@map("divisions")
}

model Member {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(100)
  role         String   @db.VarChar(100)
  divisionId   String   @map("division_id") @db.Uuid
  email        String   @db.VarChar(255)
  github       String   @default("") @db.VarChar(255)
  linkedin     String   @default("") @db.VarChar(255)
  imageUrl     String   @default("") @map("image_url") @db.Text
  bio          String   @default("") @db.Text
  skills       String[] @default([])
  isLeadership Boolean  @default(false) @map("is_leadership")
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relationships
  division          Division        @relation("DivisionMembers", fields: [divisionId], references: [id], onDelete: Restrict)
  leadOf            Division?       @relation("DivisionLead")
  projects          ProjectMember[]
  mentoredProjects  Project[]       @relation("MemberMentor")
  coordinatedEvents Event[]         @relation("EventCoordinator")

  @@index([divisionId])
  @@index([isLeadership])
  @@index([isActive])
  @@map("members")
}

// ========================================================
// PROJECTS & COLLABORATION
// ========================================================

model Project {
  id          String   @id @default(uuid()) @db.Uuid
  title       String   @db.VarChar(200)
  slug        String   @unique @db.VarChar(200)
  problem     String   @db.Text
  solution    String   @db.Text
  description String   @db.Text
  imageUrl    String   @default("") @map("image_url") @db.Text
  tags        String[] @default([])

  // Mentor Relationships
  mentorFacultyId    String? @map("mentor_faculty_id") @db.Uuid
  mentorMemberId     String? @map("mentor_member_id") @db.Uuid
  externalMentorName String? @map("external_mentor_name") @db.VarChar(100)

  progress     Int           @default(0)
  githubUrl    String        @default("") @map("github_url") @db.VarChar(255)
  demoUrl      String        @default("") @map("demo_url") @db.VarChar(255)
  status       ProjectStatus @default(ACTIVE)
  featured     Boolean       @default(false)
  displayOrder Int           @default(0) @map("display_order")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  // Relationships
  teamMembers   ProjectMember[]
  mentorFaculty FacultyCoordinator? @relation("FacultyMentor", fields: [mentorFacultyId], references: [id], onDelete: SetNull)
  mentorMember  Member?             @relation("MemberMentor", fields: [mentorMemberId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([featured])
  @@index([mentorFacultyId])
  @@index([mentorMemberId])
  @@map("projects")
}

model ProjectMember {
  id            String   @id @default(uuid()) @db.Uuid
  projectId     String   @map("project_id") @db.Uuid
  memberId      String   @map("member_id") @db.Uuid
  roleInProject String   @default("Contributor") @map("role_in_project") @db.VarChar(100)
  displayOrder  Int      @default(0) @map("display_order")
  joinedAt      DateTime @default(now()) @map("joined_at")

  // Relationships
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  member  Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([projectId, memberId])
  @@index([projectId])
  @@index([memberId])
  @@map("project_members")
}

// ========================================================
// EVENTS & REGISTRATIONS
// ========================================================

model Event {
  id          String   @id @default(uuid()) @db.Uuid
  title       String   @db.VarChar(200)
  slug        String   @unique @db.VarChar(200)
  description String   @db.Text
  eventDate   DateTime @map("event_date") @db.Date
  eventTime   String   @map("event_time") @db.VarChar(50)
  venue       String   @db.VarChar(150)

  // Coordinator Relationships
  coordinatorId           String? @map("coordinator_id") @db.Uuid
  externalCoordinatorName String? @map("external_coordinator_name") @db.VarChar(100)

  imageUrl            String      @default("") @map("image_url") @db.Text
  status              EventStatus @default(UPCOMING)
  registrationLink    String      @default("") @map("registration_link") @db.VarChar(255)
  registrationEnabled Boolean     @default(true) @map("registration_enabled")
  winners             String[]    @default([])
  galleryUrls         String[]    @default([]) @map("gallery_urls")
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")

  // Relationships
  coordinator   Member?             @relation("EventCoordinator", fields: [coordinatorId], references: [id], onDelete: SetNull)
  registrations EventRegistration[]
  galleryItems  GalleryItem[]

  @@index([status])
  @@index([eventDate])
  @@index([coordinatorId])
  @@map("events")
}

model EventRegistration {
  id          String             @id @default(uuid()) @db.Uuid
  eventId     String             @map("event_id") @db.Uuid
  name        String             @db.VarChar(100)
  email       String             @db.VarChar(255)
  phone       String             @db.VarChar(20)
  college     String             @default("BMSIT&M") @db.VarChar(150)
  usn         String             @default("") @db.VarChar(30)
  branch      String             @db.VarChar(100)
  year        String             @db.VarChar(20)
  teamName    String?            @map("team_name") @db.VarChar(100)
  status      RegistrationStatus @default(PENDING)
  submittedAt DateTime           @default(now()) @map("submitted_at")

  // Relationships
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  // Constraint: One registration per email PER EVENT
  @@unique([eventId, email])
  @@index([eventId])
  @@index([email])
  @@map("event_registrations")
}

// ========================================================
// ACHIEVEMENTS, ANNOUNCEMENTS, PARTNERS & GALLERY
// ========================================================

model Achievement {
  id           String   @id @default(uuid()) @db.Uuid
  title        String   @db.VarChar(200)
  dateAchieved String   @map("date_achieved") @db.VarChar(50)
  description  String   @db.Text
  imageUrl     String   @default("") @map("image_url") @db.Text
  badge        String   @db.VarChar(100)
  featured     Boolean  @default(false)
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([featured])
  @@map("achievements")
}

model Announcement {
  id         String               @id @default(uuid()) @db.Uuid
  title      String               @db.VarChar(200)
  datePosted DateTime             @default(now()) @map("date_posted") @db.Date
  content    String               @db.Text
  category   AnnouncementCategory @default(GENERAL)
  isActive   Boolean              @default(true) @map("is_active")
  createdAt  DateTime             @default(now()) @map("created_at")
  updatedAt  DateTime             @updatedAt @map("updated_at")

  @@index([isActive])
  @@index([category])
  @@map("announcements")
}

model Partner {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(150)
  logoUrl      String   @default("") @map("logo_url") @db.Text
  partnerType  String   @map("partner_type") @db.VarChar(100)
  description  String   @db.Text
  website      String   @db.VarChar(255)
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("partners")
}

model GalleryItem {
  id           String          @id @default(uuid()) @db.Uuid
  imageUrl     String          @map("image_url") @db.Text
  caption      String          @db.Text
  category     GalleryCategory @default(EVENTS)
  eventId      String?         @map("event_id") @db.Uuid
  displayOrder Int             @default(0) @map("display_order")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  // Relationships
  event Event? @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([category])
  @@index([eventId])
  @@map("gallery_items")
}

// ========================================================
// RECRUITMENT APPLICATIONS & CONTACT INQUIRIES
// ========================================================

model Application {
  id          String            @id @default(uuid()) @db.Uuid
  name        String            @db.VarChar(100)
  email       String            @db.VarChar(255)
  phone       String            @db.VarChar(20)
  branch      String            @db.VarChar(100)
  year        String            @db.VarChar(20)
  divisionId  String            @map("division_id") @db.Uuid
  skills      String            @db.Text
  motivation  String            @db.Text
  projects    String            @default("") @db.Text
  github      String            @default("") @db.VarChar(255)
  linkedin    String            @default("") @db.VarChar(255)
  portfolio   String            @default("") @db.VarChar(255)
  resumeUrl   String            @default("") @map("resume_url") @db.Text
  resumeName  String            @default("") @map("resume_name") @db.VarChar(255)
  status      ApplicationStatus @default(PENDING)
  adminNotes  String            @default("") @map("admin_notes") @db.Text
  submittedAt DateTime          @default(now()) @map("submitted_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  // Relationships
  division Division @relation(fields: [divisionId], references: [id], onDelete: Restrict)

  @@index([divisionId])
  @@index([status])
  @@index([submittedAt])
  @@map("applications")
}

model ContactMessage {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(100)
  email       String   @db.VarChar(255)
  subject     String   @db.VarChar(200)
  message     String   @db.Text
  isRead      Boolean  @default(false) @map("is_read")
  adminReply  String   @default("") @map("admin_reply") @db.Text
  submittedAt DateTime @default(now()) @map("submitted_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([isRead])
  @@index([submittedAt])
  @@map("contact_messages")
}

// ========================================================
// SINGLETON / CONFIG DATA (FACULTY & STATS)
// ========================================================

model FacultyCoordinator {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(100)
  designation  String   @db.VarChar(150)
  department   String   @db.VarChar(150)
  imageUrl     String   @default("") @map("image_url") @db.Text
  bio          String   @db.Text
  email        String   @db.VarChar(255)
  phone        String   @db.VarChar(50)
  office       String   @db.VarChar(150)
  displayOrder Int      @default(0) @map("display_order")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relationships
  mentoredProjects Project[] @relation("FacultyMentor")

  @@map("faculty_coordinators")
}

model SiteMetricsConfig {
  id                    String   @id @default(uuid()) @db.Uuid
  overrideComputedStats Boolean  @default(false) @map("override_computed_stats")
  manualProjectsCount   Int?     @map("manual_projects_count")
  manualEventsCount     Int?     @map("manual_events_count")
  manualMembersCount    Int?     @map("manual_members_count")
  manualDivisionsCount  Int?     @map("manual_divisions_count")
  manualPartnersCount   Int?     @map("manual_partners_count")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@map("site_metrics_config")
}
